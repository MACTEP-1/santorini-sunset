<?xml version="1.0" encoding="UTF-8"?>
<!--
  Santorini Sunset - Connect IQ watch face manifest

  minApiLevel is 4.2.0 (bumped from 4.0.0, itself bumped from the original
  Arctic Peak project's 3.3.0). The 4.0.0 bump was for the photo
  background's Dc.drawScaledBitmap(). The 4.2.0 bump is for the
  long-press-to-swap-fields feature (WatchUi.WatchFaceDelegate.onPress())
  - see rossonero/manifest.xml's longer comment for the full API research.
  UNLIKE rossonero/milan-personal, this doesn't drop any device from the
  list below: it already excludes vivoactive4 (dropped earlier, before
  this round, for an unrelated reason - see README.md), and every
  remaining device here is API 5.0+ per Garmin's own compatible-devices
  table, comfortably clear of 4.2.0.

  NOTE ON DEVICE IDS: this list is managed by you directly via "Monkey C:
  Edit Products" in VS Code - only minApiLevel was touched above, the
  <iq:products> list itself is untouched.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="8eb35071-3151-4f55-9fb1-06664f01f526" type="watchface" name="@Strings.AppName" entry="SantoriniSunsetApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="4.2.0">
        <iq:products>
            <iq:product id="epix2"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr965"/>
            <iq:product id="venu2"/>
            <iq:product id="venu2s"/>
            <iq:product id="vivoactive5"/>
        </iq:products>
        <!-- Permission history: "Weather" was tried first and rejected by a
         real compiler run ("Invalid permission provided: Weather") -
         confirmed against Garmin's Toybox.Weather/CurrentConditions docs
         that no permission at all is needed for .temperature specifically,
         so the block was left empty rather than filled with a different id.

         Positioning ADDED in the "second hand / move bar / sunrise-sunset /
         step ring" round: the new Sunrise/Sunset fields call
         Weather.getSunrise()/getSunset(), which need a Position.Location -
         both places SantoriniSunsetView.mc's sunLocation() can get one from
         (Activity.Info.currentLocation,
         Weather.CurrentConditions.observationLocationPosition) are
         themselves gated behind this exact permission. Fittingly literal
         for this project in particular, though see sunriseText()/
         sunsetText()'s comments for how uncertain actually getting a
         location back is. No other new permission is needed for anything
         else in this round. -->
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
    </iq:application>
</iq:manifest>